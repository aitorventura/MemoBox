<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.memobox.controller.MainController"
            styleClass="root-pane">

    <stylesheets>
        <URL value="@../css/styles.css" />
    </stylesheets>

    <!-- SIDEBAR IZQUIERDO -->
    <left>
        <VBox styleClass="sidebar" spacing="4">

            <!-- Logo / Nombre -->
            <VBox styleClass="sidebar-brand" alignment="CENTER">
                <Label text="MB" styleClass="brand-icon"/>
                <Label text="MemoBox" styleClass="brand-name"/>
                <Label text="Tarjetas de estudio" styleClass="brand-sub"/>
            </VBox>

            <Separator styleClass="sidebar-sep"/>

            <Label text="NAVEGACION" styleClass="nav-section-label"/>

            <Button fx:id="btnDashboard" text="  Inicio"
                    onAction="#onDashboard"
                    styleClass="nav-btn, nav-active"
                    maxWidth="Infinity"/>

            <Button fx:id="btnDecks" text="  Mis mazos"
                    onAction="#onDecks"
                    styleClass="nav-btn"
                    maxWidth="Infinity"/>

            <Button fx:id="btnStats" text="  Estadisticas"
                    onAction="#onStats"
                    styleClass="nav-btn"
                    maxWidth="Infinity"/>

            <VBox VBox.vgrow="ALWAYS"/>

            <Separator styleClass="sidebar-sep"/>
            <Label fx:id="lblUsername" text="" styleClass="sidebar-username"/>
            <Button text="🚪 Cerrar sesion"
                    onAction="#onLogout"
                    styleClass="btn-logout"
                    maxWidth="Infinity"/>
            <Label text="v1.0" styleClass="sidebar-footer"/>

        </VBox>
    </left>

    <!-- CONTENIDO CENTRAL -->
    <center>
        <StackPane fx:id="contentPane" styleClass="content-pane"/>
    </center>

</BorderPane>
