<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.memobox.controller.CardsController"
      styleClass="view-container" spacing="16">

    <stylesheets>
        <URL value="@../css/styles.css" />
    </stylesheets>
    <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>

    <!-- CABECERA -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox HBox.hgrow="ALWAYS" spacing="2">
            <Label fx:id="lblDeckName" text="Mazo" styleClass="page-title"/>
            <Label fx:id="lblStatus"   text="--"   styleClass="page-subtitle"/>
        </VBox>
        <Button text="Estudiar"      onAction="#onEstudiar"     styleClass="btn-primary"/>
        <Button text="Nueva tarjeta" onAction="#onNuevaTarjeta" styleClass="btn-secondary"/>
        <Button text="Volver"        onAction="#onVolver"       styleClass="btn-ghost"/>
    </HBox>

    <!-- FILTROS -->
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="Filtrar:" styleClass="form-label"/>
        <ComboBox fx:id="cboFiltro" styleClass="form-input" prefWidth="160"/>
        <TextField fx:id="txtBuscar" promptText="Buscar pregunta o etiqueta..."
                   styleClass="form-input" prefWidth="280" HBox.hgrow="ALWAYS"/>
    </HBox>

    <!-- TABLA -->
    <TableView fx:id="tableCards" styleClass="data-table" VBox.vgrow="ALWAYS">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        <columns>
            <TableColumn fx:id="colPregunta" text="Pregunta"         prefWidth="320"/>
            <TableColumn fx:id="colEtiqueta" text="Etiqueta"         prefWidth="110"/>
            <TableColumn fx:id="colEstado"   text="Estado"           prefWidth="110" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="colProxima"  text="Proxima revision" prefWidth="140" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="colDominio"  text="Dominio (0-5)"    prefWidth="110" style="-fx-alignment: CENTER;"/>
        </columns>
    </TableView>

    <!-- ACCIONES -->
    <HBox spacing="10">
        <Button text="Editar" onAction="#onEditar" styleClass="btn-secondary"/>
        <Button text="Borrar" onAction="#onBorrar" styleClass="btn-danger"/>
    </HBox>

</VBox>
